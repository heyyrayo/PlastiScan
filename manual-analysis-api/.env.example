# Environment variable placeholders — copy to .env and fill in real values.
# Never commit .env or any file containing real credentials.

# Required: Groq API key (server-side only, never sent to the client)
GROQ_API_KEY=your_groq_api_key_here

# Required: Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Required: Supabase anon/publishable key (minimum privilege — not the service role key)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: listening port (Render sets this automatically)
PORT=3000
